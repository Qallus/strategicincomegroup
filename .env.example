# ============================================================
# Strategic Income Group web app — environment variables
# Copy to .env.local for development. In Coolify, set these on the app.
# NEXT_PUBLIC_* values are inlined at BUILD time (Coolify passes them as build args).
# ============================================================

# ── App URLs ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Direct Postgres connection, used by `npm run db:migrate`
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ── Email (SMTP send + IMAP inbox sync) ─────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=planning@strategicincomegroup.com
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=planning@strategicincomegroup.com
IMAP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=planning@strategicincomegroup.com
RESEND_FROM_NAME=Strategic Income Group
RESEND_REPLY_TO=planning@strategicincomegroup.com
NOTIFICATION_FROM_EMAIL=planning@strategicincomegroup.com
EDIT_REQUEST_NOTIFY_EMAIL=jeremy@strategicincomegroup.com

# ── Twilio (SMS + voice) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── Web push (PWA notifications) ────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:planning@strategicincomegroup.com

# ── AI (current agent; Step 8 moves this to OpenRouter + Hermes + Paperclip)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=

# ── Scheduled jobs ──────────────────────────────────────────
# Shared secret for Coolify scheduled tasks (sent as x-cron-secret or Bearer).
CRON_SECRET=
